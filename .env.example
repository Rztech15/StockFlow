# StockFlow environment template. Safe placeholders only.
# Run `python -m scripts.init_env` (inside backend) to create a local .env with random secrets.
# Never commit .env. In production, secrets come from the host's secret manager.

APP_ENV=development
APP_BASE_URL=http://localhost:5173
# Comma-separated bare origins (no path, no trailing slash, no wildcard)
ALLOWED_ORIGINS=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info
DB_POOL_MAX=10

# --- Local PostgreSQL (docker compose) and role bootstrap ---
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_DATABASE_URL=postgresql://postgres:change-me-admin@localhost:5432/postgres
STOCKFLOW_DB_NAME=stockflow
STOCKFLOW_OWNER_PASSWORD=change-me-owner
STOCKFLOW_APP_PASSWORD=change-me-app

# Runtime connection: restricted role stockflow_app (NOBYPASSRLS, not owner, no DDL)
DATABASE_URL=postgresql://stockflow_app:change-me-app@localhost:5432/stockflow
# Migration connection: owner role. Migration/deploy jobs ONLY. Must NOT be set in a production runtime.
MIGRATION_DATABASE_URL=postgresql://stockflow_owner:change-me-owner@localhost:5432/stockflow

# Versioned secret pepper (min 32 chars). Used from Phase 1 onwards.
PASSWORD_PEPPER_V1=change-me-pepper

# --- SMTP (local: Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="StockFlow <no-reply@localhost>"
